{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "himalayan-regency-cloudflare-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-19",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "himalayan-regency-db", "database_id": "dedfd31e-af4a-43b1-9f7f-a1e3428d63c4", "migrations_dir": "migrations" }
  ]
}
