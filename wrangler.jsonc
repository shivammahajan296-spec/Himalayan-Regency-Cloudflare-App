{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "himalayan-regency-daybook",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-19",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "himalayan-regency-db", "database_id": "REPLACE_WITH_DATABASE_ID", "migrations_dir": "migrations" }
  ]
}
